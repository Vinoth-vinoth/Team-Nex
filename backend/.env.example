PORT=5000
# 0.0.0.0 makes the backend reachable from a phone on the same Wi-Fi.
# Do not set this to 127.0.0.1 - the phone will not be able to connect.
HOST=0.0.0.0
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=intelligent_timetable
JWT_SECRET=replace_with_a_long_random_secret
